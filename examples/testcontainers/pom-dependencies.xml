<!--
    Maven dependencies for Testcontainers + Cucumber + Spring Boot integration tests.

    Add these to the pilot repository's pom.xml under <dependencies>.
    All are test-scoped — they don't ship in production.

    Reference: ADR-0002, Story 3, T3.2
-->

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- Testcontainers BOM — manages versions for all testcontainers modules      -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!--
    Add this in <dependencyManagement>:

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.19.8</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
-->

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- Core Testcontainers                                                        -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->

<!-- Core library — container lifecycle, networking, wait strategies -->
<dependency>
    <groupId>org.testcontainers</groupId>
    <artifactId>testcontainers</artifactId>
    <scope>test</scope>
</dependency>

<!-- JUnit 5 integration — @Testcontainers, @Container annotations -->
<dependency>
    <groupId>org.testcontainers</groupId>
    <artifactId>junit-jupiter</artifactId>
    <scope>test</scope>
</dependency>

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- Testcontainers modules — one per service                                   -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->

<!-- Kafka module — provides KafkaContainer with KRaft or Zookeeper mode -->
<dependency>
    <groupId>org.testcontainers</groupId>
    <artifactId>kafka</artifactId>
    <scope>test</scope>
</dependency>

<!-- LocalStack module — AWS service emulation (S3, SQS, SNS, DynamoDB, etc.) -->
<dependency>
    <groupId>org.testcontainers</groupId>
    <artifactId>localstack</artifactId>
    <scope>test</scope>
</dependency>

<!--
    Redis — no dedicated Testcontainers module needed.
    Use GenericContainer with the redis image (see RedisContainerConfig.java).
-->

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- Spring Boot Test                                                            -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->

<!-- Spring Boot Test — @SpringBootTest, @DynamicPropertySource -->
<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-test</artifactId>
    <scope>test</scope>
</dependency>

<!-- Spring Kafka Test — embedded broker utilities (optional, if using @EmbeddedKafka fallback) -->
<dependency>
    <groupId>org.springframework.kafka</groupId>
    <artifactId>spring-kafka-test</artifactId>
    <scope>test</scope>
</dependency>

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- Cucumber                                                                    -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->

<!-- Cucumber BOM — add to <dependencyManagement>:
    <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>7.18.0</version>
        <type>pom</type>
        <scope>import</scope>
    </dependency>
-->

<!-- Cucumber Java — step definition annotations (@Given, @When, @Then) -->
<dependency>
    <groupId>io.cucumber</groupId>
    <artifactId>cucumber-java</artifactId>
    <scope>test</scope>
</dependency>

<!-- Cucumber Spring — injects Spring beans into step definitions -->
<dependency>
    <groupId>io.cucumber</groupId>
    <artifactId>cucumber-spring</artifactId>
    <scope>test</scope>
</dependency>

<!-- Cucumber JUnit Platform Engine — runs Cucumber via JUnit 5 (@Suite) -->
<dependency>
    <groupId>io.cucumber</groupId>
    <artifactId>cucumber-junit-platform-engine</artifactId>
    <scope>test</scope>
</dependency>

<!-- JUnit Platform Suite — @Suite, @SelectClasspathResource annotations -->
<dependency>
    <groupId>org.junit.platform</groupId>
    <artifactId>junit-platform-suite</artifactId>
    <scope>test</scope>
</dependency>

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- AWS SDK (for LocalStack integration tests)                                 -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->

<!-- Only needed if tests interact with AWS services via LocalStack -->
<dependency>
    <groupId>software.amazon.awssdk</groupId>
    <artifactId>bom</artifactId>
    <version>2.25.60</version>
    <type>pom</type>
    <scope>import</scope>
</dependency>

