<!--
    Maven dependencies for Testcontainers + Cucumber integration tests.
    Based on the real FDP pom.xml structure.

    The FDP project uses:
    - fdp-bom (manages Spring Boot, Kafka, Cucumber versions)
    - cucumber-junit (JUnit 4 vintage runner — existing pattern)
    - cucumber-java + cucumber-spring (step definitions + Spring DI)
    - junit-vintage-engine (runs JUnit 4 tests under JUnit 5 platform)
    - cucumber-junit-platform-engine (JUnit 5 native alternative)

    To add Testcontainers, add ONLY the following to the integration-tests module pom.xml.
    Everything else (Cucumber, Spring Boot Test, etc.) already exists.

    Reference: ADR-0002, Story 4, T4.2
-->

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- ADD TO <dependencyManagement> in the PARENT pom.xml                        -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!--
    <dependencyManagement>
        <dependencies>
            ... existing fdp-bom import ...

            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.19.8</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
-->

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- ADD TO <dependencies> in cmd-adaptor-dvla-integration-tests/pom.xml        -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->

<!-- Core Testcontainers — container lifecycle, networking, wait strategies -->
<dependency>
    <groupId>org.testcontainers</groupId>
    <artifactId>testcontainers</artifactId>
    <scope>test</scope>
</dependency>

<!-- JUnit 5 integration — @Testcontainers annotation support -->
<dependency>
    <groupId>org.testcontainers</groupId>
    <artifactId>junit-jupiter</artifactId>
    <scope>test</scope>
</dependency>

<!-- Kafka module — provides KafkaContainer with Zookeeper/KRaft support -->
<dependency>
    <groupId>org.testcontainers</groupId>
    <artifactId>kafka</artifactId>
    <scope>test</scope>
</dependency>

<!--
    Redis — no dedicated module needed.
    Use GenericContainer with redis:5.0.6 image (see RedisContainerConfig.java).
-->

<!--
    LocalStack — only if tests need AWS service emulation (currently only IAM).
    Uncomment if needed:

    <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>localstack</artifactId>
        <scope>test</scope>
    </dependency>
-->

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- ALREADY EXISTS in the FDP project (no changes needed for these)             -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!--
    These are already in the integration-tests pom.xml:
    - io.cucumber:cucumber-java (step definitions)
    - io.cucumber:cucumber-junit (JUnit 4 runner)
    - io.cucumber:cucumber-spring (Spring DI in steps)
    - io.cucumber:cucumber-junit-platform-engine (JUnit 5)
    - org.junit.vintage:junit-vintage-engine (JUnit 4 compat)
    - org.junit.jupiter:junit-jupiter (JUnit 5)
    - org.springframework.boot:spring-boot-starter-test (Spring Boot Test)
    - org.apache.kafka:kafka-streams-test-utils (Kafka Streams testing)

    No changes needed for the above — they already work with Testcontainers.
-->

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- MAVEN PROFILE CHANGE (cmd-adaptor-dvla-integration-tests/pom.xml)           -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!--
    Add a new profile for Testcontainers-based integration tests:

    <profile>
        <id>testcontainers</id>
        <properties>
            <skip.containers>true</skip.containers>
            <skip.aggregators>true</skip.aggregators>
            <skip.integration.tests>false</skip.integration.tests>
            <!-- Ports are dynamic — set by @DynamicPropertySource in CucumberSpringConfig -->
        </properties>
    </profile>

    Usage: ./mvnw verify -pl cmd-adaptor-dvla-integration-tests -P testcontainers
    This skips docker-compose-maven-plugin entirely and lets Testcontainers manage infra.
-->
